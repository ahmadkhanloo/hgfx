      "classification": "PUBLIC_PRIMITIVE_UNCLIPPED_FOR_COMMON_QUANTITY"
    }
  ],
  "common_derived_quantities": {
    "first_level_input_surprise": {
      "definition": "-log(p) if u=1 else -log(1-p)",
      "pyhgf_evaluation": "binary_surprise(u, p, clipping=false)",
      "native_clipped_wrapper_is_direct_oracle": false
    },
    "participant_response_nll": {
      "transformed_probability": "q = p^ze / (p^ze + (1-p)^ze)",
      "definition": "-[y*log(q) + (1-y)*log(1-q)]",
      "hgfx_evaluation": "-unitsq_sgm.logp",
      "pyhgf_evaluation": "binary_surprise(y, q, clipping=false)",
      "native_clipped_wrapper_is_direct_oracle": false
    }
  },
  "runtime_preflight_assertions": [
    "jax.config.read('jax_enable_x64') is True",
    "jax.default_backend() == 'cpu'",
    "all mapped pyhgf floating trajectory arrays are float64",
    "pyhgf precision_clipping_value == 0.0",
    "pyhgf max_posterior_precision is positive infinity"
  ],
  "required_boundary_diagnostics": [
    "min/max first-level predicted probability per implementation",
    "count and coordinates of p exactly equal to 0 or 1",
    "maximum finite level-2 posterior precision per implementation",
    "maximum finite level-3 posterior precision per implementation",
    "NaN/+inf/-inf counts and coordinates for every compared field",
    "actual dtype for every compared array"
  ],
  "boundary_failure_policy": {
