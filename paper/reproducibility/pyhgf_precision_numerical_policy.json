    "exact_versions_frozen_before_empirical_run": true
  },
  "pyhgf_network_configuration": {
    "volatility_updates": "standard",
    "mean_field_updates": true,
    "precision_clipping_value": 0.0,
    "max_posterior_precision": "inf",
    "classification": "PUBLIC_GUARDS_NEUTRALIZED_FOR_COMMON_SCOPE"
  },
  "guard_mapping": [
    {
      "guard": "binary prediction clipping",
      "pyhgf_default": "precision_clipping_value=1e-6",
      "hgfx_frozen_standard_hgf": "unclipped",
      "common_scope": "precision_clipping_value=0.0",
      "classification": "PUBLIC_GUARD_NEUTRALIZED_FOR_COMMON_SCOPE"
    },
    {
      "guard": "posterior precision cap",
      "pyhgf_default": "max_posterior_precision=1e10",
